{
  "alias.a": "add",
  "alias.aa": "add --all",
  "alias.ap": "add --patch",
  "alias.b": "branch",
  "alias.ba": "branch --all",
  "alias.bc": "!git symbolic-ref --quiet --short HEAD",
  "alias.bd": "branch --delete",
  "alias.c": "clone",
  "alias.ci": "commit",
  "alias.cia": "commit --all",
  "alias.ciaam": "commit --amend --all --message",
  "alias.ciam": "commit --all --message",
  "alias.cim": "commit --message",
  "alias.cl": "clone",
  "alias.co": "checkout",
  "alias.cob": "checkout -b",
  "alias.cof": "checkout --",
  "alias.d": "diff",
  "alias.ds": "diff --staged",
  "alias.dsw": "diff --staged --ignore-all-space",
  "alias.dw": "diff --ignore-all-space",
  "alias.f": "fetch",
  "alias.h": "help",
  "alias.i": "init",
  "alias.l": "log",
  "alias.la": "log --date=short --pretty=format:%h%x20%ad%x20-%x20[%an]%x20%s --graph",
  "alias.last": "log -1 HEAD --stat",
  "alias.lg": "log --graph --decorate --oneline --all",
  "alias.lr": "log --walk-reflogs",
  "alias.ls": "ls-files",
  "alias.lsg": "ls-files --others --ignored --exclude-standard",
  "alias.mg": "merge",
  "alias.mgn": "merge --no-ff",
  "alias.mgnm": "merge --no-ff --message",
  "alias.mgs": "merge --squash",
  "alias.mgt": "mergetool",
  "alias.pl": "pull",
  "alias.plo": "pull origin",
  "alias.ps": "push",
  "alias.ps1": "!f() { branch=$(git symbolic-ref --quiet --short HEAD) || exit; git push --set-upstream origin \"$branch\" \"$@\"; }; f",
  "alias.psa": "push --recurse-submodules=on-demand",
  "alias.psaa": "push --all",
  "alias.pso": "push origin",
  "alias.pst": "push --tags",
  "alias.rb": "rebase --committer-date-is-author-date",
  "alias.rba": "rebase --abort",
  "alias.rbc": "rebase --continue",
  "alias.rbi": "rebase --interactive --committer-date-is-author-date",
  "alias.rbs": "rebase --skip",
  "alias.rl": "reflog",
  "alias.rs": "reset",
  "alias.rsh": "reset --hard",
  "alias.rss": "reset --soft",
  "alias.rt": "remote",
  "alias.rtpo": "remote prune origin",
  "alias.s": "status --short",
  "alias.sh": "stash",
  "alias.size": "count-objects -vH",
  "alias.sm": "submodule",
  "alias.so": "show",
  "alias.sr": "remote show origin",
  "alias.st": "status --short --branch",
  "alias.stat": "!f() { echo '--- Branch ---'; git branch --show-current; echo; git status --short --branch; echo; echo '--- Changes (lines) ---'; git diff --stat HEAD; }; f",
  "alias.sts": "!f() { echo '=== Staged ==='; git diff --cached --numstat; echo; echo '=== Unstaged ==='; git diff --numstat; echo; echo '=== Untracked ==='; git ls-files --others --exclude-standard; }; f",
  "alias.sw": "switch",
  "alias.swc": "switch --create",
  "alias.t": "tag",
  "alias.ta": "tag --annotate",
  "alias.tig": "!tig",
  "alias.unstage": "restore --staged",
  "alias.v": "!git version",
  "branch.sort": "-committerdate",
  "color.ui": "auto",
  "commit.verbose": "true",
  "core.autocrlf": "input",
  "core.editor": "code --wait",
  "core.excludesFile": "~/.config/1bite/gitignore-global",
  "core.pager": "delta",
  "delta.line-numbers": "true",
  "delta.navigate": "true",
  "delta.side-by-side": "false",
  "diff.algorithm": "histogram",
  "diff.colorMoved": "default",
  "diff.tool": "vscode",
  "difftool.prompt": "false",
  "difftool.vscode.cmd": "code --wait --diff \"$LOCAL\" \"$REMOTE\"",
  "fetch.prune": "true",
  "help.autocorrect": "prompt",
  "init.defaultBranch": "main",
  "interactive.diffFilter": "delta --color-only",
  "merge.conflictStyle": "zdiff3",
  "merge.tool": "vscode",
  "mergetool.keepBackup": "false",
  "mergetool.vscode.cmd": "code --wait \"$MERGED\"",
  "pull.rebase": "true",
  "push.autoSetupRemote": "true",
  "push.default": "current",
  "push.followTags": "true",
  "rebase.autoStash": "true",
  "rerere.enabled": "true",
  "tag.sort": "-version:refname"
}
